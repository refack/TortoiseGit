//
// UnitTests.rc - the test executable's own resources
//

#include <windows.h>

/////////////////////////////////////////////////////////////////////////////
//
// Version - CPathUtils.GetCopyrightForSelf reads this back from the running exe
//
#include <tgitlib/version.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION FILEVER
 PRODUCTVERSION PRODUCTVER
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName", "https://tortoisegit.org/"
            VALUE "FileDescription", "TortoiseGit UnitTests"
            VALUE "FileVersion", STRFILEVER
            VALUE "InternalName", "TGitUnitTests"
            VALUE "LegalCopyright", "Copyright (C) 2008-2026 - TortoiseGit and Copyright (C) 2003-2020 - TortoiseSVN"
            VALUE "OriginalFilename", "TGitUnitTests.exe"
            VALUE "ProductName", "TortoiseGit"
            VALUE "ProductVersion", STRPRODUCTVER
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
