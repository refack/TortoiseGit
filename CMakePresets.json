{
  "version": 10,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "debug - msvc - ninja",
      "generator": "Ninja",
      "binaryDir": "build/debug",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "trace": {
        "mode": "expand",
        "redirect": "CMakeTrace.txt"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VCPKG_MANIFEST_INSTALL": "OFF"
      }
    }
  ]
}
