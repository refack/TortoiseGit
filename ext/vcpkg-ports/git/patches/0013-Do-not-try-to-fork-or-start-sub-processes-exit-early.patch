From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sven Strickroth <email@cs-ware.de>
Date: Sun, 7 Feb 2016 16:19:54 +0100
Subject: Do not try to fork or start sub processes, exit early before setting
 up handles and pipes

Signed-off-by: Sven Strickroth <email@cs-ware.de>
---
 run-command.c | 4 ++++
 sub-process.c | 2 ++
 2 files changed, 6 insertions(+)

diff --git a/run-command.c b/run-command.c
index e70a8a387b..086e885ede 100644
--- a/run-command.c
+++ b/run-command.c
@@ -681,6 +681,8 @@ int start_command(struct child_process *cmd)
 	int failed_errno;
 	const char *str;
 
+	return -1; // early return, before we might initialize handles
+
 	/*
 	 * In case of errors we must keep the promise to close FDs
 	 * that have been passed in via ->in and ->out.
@@ -1166,6 +1168,8 @@ int start_async(struct async *async)
 	int fdin[2], fdout[2];
 	int proc_in, proc_out;
 
+	return -1; // early return, before we might initialize handles
+
 	need_in = async->in < 0;
 	if (need_in) {
 		if (pipe(fdin) < 0) {
diff --git a/sub-process.c b/sub-process.c
index 2d5c965169..fd7a7f09fa 100644
--- a/sub-process.c
+++ b/sub-process.c
@@ -78,6 +78,8 @@ int subprocess_start(struct hashmap *hashmap, struct subprocess_entry *entry, co
 	int err;
 	struct child_process *process;
 
+	return -1; // early return, before we might initialize handles
+
 	entry->cmd = cmd;
 	process = &entry->process;
 
