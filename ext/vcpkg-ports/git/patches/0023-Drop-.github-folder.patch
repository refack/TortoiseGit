-    permissions:
-      issues: write
-    strategy:
-      matrix:
-        component:
-          - label: git
-            feed: https://github.com/git/git/tags.atom
-          - label: git-lfs
-            feed: https://github.com/git-lfs/git-lfs/tags.atom
-          - label: git-credential-manager
-            feed: https://github.com/git-ecosystem/git-credential-manager/tags.atom
