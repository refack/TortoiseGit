 contrib/git.ico | Bin 0 -> 55316 bytes
 2 files changed, 9 insertions(+)
 create mode 100644 .tgitconfig
 create mode 100644 contrib/git.ico

diff --git a/.tgitconfig b/.tgitconfig
new file mode 100644
index 0000000000..9f5293264a
--- /dev/null
+++ b/.tgitconfig
@@ -0,0 +1,9 @@
+[bugtraq]
+	url = https://tortoisegit.org/issue/%BUGID%
+	logregex = "[Ii]ssues?:?(\\s*(,|and)?\\s*#?\\d+)+\n(\\d+)"
+	warnifnoissue = false
+
+[tgit]
+	warnnosignedoffby = true
+	projectlanguage = 1033
+	icon = contrib/git.ico
diff --git a/contrib/git.ico b/contrib/git.ico
new file mode 100644
