From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sven Strickroth <email@cs-ware.de>
Date: Sun, 4 Dec 2011 13:45:39 +0100
Subject: make --follow work with gitdll.dll

Related to issue #337 and issue #678.

Signed-off-by: Sven Strickroth <email@cs-ware.de>
---
 log-tree.c | 2 --
 1 file changed, 2 deletions(-)

diff --git a/log-tree.c b/log-tree.c
index 88b3019293..9de6548445 100644
--- a/log-tree.c
+++ b/log-tree.c
@@ -1190,7 +1190,6 @@ int log_tree_commit(struct rev_info *opt, struct commit *commit)
 	shown = log_tree_diff(opt, commit, &log);
 	if (!shown && opt->loginfo && opt->always_show_header) {
 		log.parent = NULL;
-		show_log(opt);
 		shown = 1;
 	}
 	if (opt->track_linear && !opt->linear && opt->reverse_output_stage)
@@ -1198,7 +1197,6 @@ int log_tree_commit(struct rev_info *opt, struct commit *commit)
 	if (shown)
 		show_diff_of_diff(opt);
 	opt->loginfo = NULL;
-	maybe_flush_or_die(opt->diffopt.file, "stdout");
 	opt->diffopt.no_free = no_free;
 
 	diff_free(&opt->diffopt);
