From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sven Strickroth <email@cs-ware.de>
Date: Sat, 12 Nov 2011 00:49:13 +0100
Subject: Do not use pager (also caused crashes in gitdll.dll in some cases)

Signed-off-by: Sven Strickroth <email@cs-ware.de>
---
 pager.c | 48 +++---------------------------------------------
 1 file changed, 3 insertions(+), 45 deletions(-)

diff --git a/pager.c b/pager.c
index 35b210e048..b482cf01f8 100644
--- a/pager.c
+++ b/pager.c
@@ -84,26 +84,7 @@ static int core_pager_config(const char *var, const char *value,
 
 const char *git_pager(struct repository *r, int stdout_is_tty)
 {
-	const char *pager;
-
-	if (!stdout_is_tty)
-		return NULL;
-
-	pager = getenv("GIT_PAGER");
-	if (!pager) {
-		if (!pager_program)
-			read_early_config(r,
-					  core_pager_config, NULL);
-		pager = pager_program;
-	}
-	if (!pager)
-		pager = getenv("PAGER");
-	if (!pager)
-		pager = DEFAULT_PAGER;
-	if (!*pager || !strcmp(pager, "cat"))
-		pager = NULL;
-
-	return pager;
+	return NULL;
 }
 
 static void setup_pager_env(struct strvec *env)
@@ -192,7 +173,7 @@ void setup_pager(struct repository *r)
 
 int pager_in_use(void)
 {
-	return git_env_bool("GIT_PAGER_IN_USE", 0);
+	return 0;
 }
 
 /*
@@ -275,34 +256,11 @@ static int pager_command_config(const char *var, const char *value,
 				const struct config_context *ctx UNUSED,
 				void *vdata)
 {
-	struct pager_command_config_data *data = vdata;
-	const char *cmd;
-
-	if (skip_prefix(var, "pager.", &cmd) && !strcmp(cmd, data->cmd)) {
-		int b = git_parse_maybe_bool(value);
-		if (b >= 0)
-			data->want = b;
-		else {
-			data->want = 1;
-			data->value = xstrdup(value);
-		}
-	}
-
 	return 0;
 }
 
 /* returns 0 for "no pager", 1 for "use pager", and -1 for "not specified" */
 int check_pager_config(struct repository *r, const char *cmd)
 {
-	struct pager_command_config_data data;
-
-	data.cmd = cmd;
-	data.want = -1;
-	data.value = NULL;
-
-	read_early_config(r, pager_command_config, &data);
-
-	if (data.value)
-		pager_program = data.value;
-	return data.want;
+	return 0;
 }
