-static const char *drop_prefix(const char *name, uint32_t category)
-{
-	const char *new_name;
-	const char *prefix;
-
-	switch (category) {
-	case CAT_guide:
-	case CAT_userinterfaces:
-	case CAT_developerinterfaces:
-		prefix = "git";
-		break;
-	default:
-		prefix = "git-";
-		break;
-	}
-	if (skip_prefix(name, prefix, &new_name))
-		return new_name;
-
-	return name;
-}
