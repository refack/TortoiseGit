 #define ETC_GITCONFIG "etc\\gitconfig"
 #define ETC_GITATTRIBUTES "etc\\gitattributes"
 #define GIT_EXEC_PATH "bin"
@@ -12,6 +18,8 @@
 #define GIT_HTML_PATH "doc\\git\\html"
