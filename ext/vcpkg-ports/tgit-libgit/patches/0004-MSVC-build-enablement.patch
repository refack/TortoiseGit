--- a/compat/mingw.c
+++ b/compat/mingw.c
@@ -693,7 +693,7 @@ int mingw_unlink(const char *pathname, int handle_in_use_error)
 
 static int is_dir_empty(const wchar_t *wpath)
 {
-	WIN32_FIND_DATAW findbuf;
+	WIN32_FIND_DATAW findbuf = { 0 };
 	HANDLE handle;
