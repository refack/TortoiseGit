diff --git a/compat/msvc.h b/compat/msvc.h
index cf22f63cf4..df169902f8 100644
--- a/compat/msvc.h
+++ b/compat/msvc.h
@@ -4,6 +4,12 @@
 #include "msvc-posix.h"
 #include "mingw.h"
 
+/* Git runtime infomation */
+#define RUNTIME_PREFIX
+#define FALLBACK_RUNTIME_PREFIX ""
+#define PREFIX "."
+#define BINDIR "bin"
