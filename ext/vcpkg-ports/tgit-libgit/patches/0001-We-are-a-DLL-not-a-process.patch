+#undef close
+int mingw_close(int fileHandle)
+{
+	if (fileHandle >= 0)
+	{
+		if (remove_handle(fileHandle) == TRUE)
+			return close(fileHandle);
+
+		return FALSE;
+	}
+
+	return close(fileHandle);
+}
