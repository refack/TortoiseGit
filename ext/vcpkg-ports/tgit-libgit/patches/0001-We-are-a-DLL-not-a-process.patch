@@ -1098,6 +1180,15 @@ FILE *mingw_freopen (const char *filename, const char *otype, FILE *stream)
 	return file;
 }
 
+#undef fclose
+int mingw_fclose(FILE * stream)
+{
+	if (remove_handle(fileno(stream)) == TRUE)
+		return fclose(stream);
+
+	return FALSE;
+}
