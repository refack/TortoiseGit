+	 * odb_close() above closes the pack file handles, which is all upstream
+	 * needs. TortoiseGit additionally has to make the store forget which
+	 * packs it found, so the next lookup rediscovers them - TGitCache and
+	 * gitdll outlive any single repack.
+	 *
+	 * The store used to hang off odb_source directly. Since v2.55 the source
+	 * is polymorphic and only the files backend has packs, so downcast - and
+	 * check the type first, because odb_source_files_downcast() is a BUG()
+	 * on anything else and alternates need not be files-backed.
+	 */
+	for (struct odb_source *source = o->sources; source; source = source->next) {
+		if (source->type != ODB_SOURCE_FILES)
+			continue;
+		packfile_store_close_tgit(odb_source_files_downcast(source)->packed);
+	}
+}
