diff --git a/src/libgit2/repository.c b/src/libgit2/repository.c
index 9fed12cd7..8205b3557 100644
--- a/src/libgit2/repository.c
+++ b/src/libgit2/repository.c
@@ -567,16 +567,27 @@ static int validate_ownership_cb(const git_config_entry *entry, void *payload)
 	} else if (strcmp(entry->value, "*") == 0) {
 		*data->is_safe = true;
 	} else {
+		bool is_prefix = false, match;
+
 		if (git_str_sets(&data->tmp, entry->value) < 0)
 			return -1;
 
+		/*
+		 * A value ending with slash* is treated as a prefix match.
+		 * Strip only the '*', leaving the trailing slash in place.
+		 */
+		if (git__suffixcmp(data->tmp.ptr, "/*") == 0) {
+			is_prefix = true;
+			git_str_shorten(&data->tmp, 1);
+		}
+
 		if (!git_fs_path_is_root(data->tmp.ptr)) {
 			/* Input must not have trailing backslash. */
 			if (!data->tmp.size ||
-			    data->tmp.ptr[data->tmp.size - 1] == '/')
+			    (!is_prefix && data->tmp.ptr[data->tmp.size - 1] == '/'))
 				return 0;
 
-			if (git_fs_path_to_dir(&data->tmp) < 0)
+			if (!is_prefix && git_fs_path_to_dir(&data->tmp) < 0)
 				return -1;
 		}
 
@@ -608,7 +619,11 @@ static int validate_ownership_cb(const git_config_entry *entry, void *payload)
 		if (strncmp(test_path, "%(prefix)//", strlen("%(prefix)//")) == 0)
 			test_path += strlen("%(prefix)/");
 
-		if (strcmp(test_path, data->repo_path) == 0)
+		match = is_prefix ?
+			(git__prefixcmp(data->repo_path, test_path) == 0) :
+			(strcmp(test_path, data->repo_path) == 0);
+
+		if (match)
 			*data->is_safe = true;
 	}
 
@@ -707,10 +722,12 @@ static int validate_ownership(git_repository *repo)
 	if (!is_safe) {
 		size_t path_len = git_fs_path_is_root(path) ?
 			strlen(path) : git_fs_path_dirlen(path);
-
+		const char *prefix = "";
+		if (!strncasecmp(path, "//", strlen("//")))
+			prefix = "%(prefix)/";
 		git_error_set(GIT_ERROR_CONFIG,
-			"repository path '%.*s' is not owned by current user",
-			(int)min(path_len, INT_MAX), path);
+			"repository path '%.*s' is not owned by current user.\n\nTo add an exception for this directory, call:\ngit config --global --add safe.directory '%s%.*s'",
+			(int)min(path_len, INT_MAX), path, prefix, (int)min(path_len, INT_MAX), path);
 		error = GIT_EOWNER;
 	}
 
