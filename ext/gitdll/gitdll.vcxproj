<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{4F0A55DE-DAFD-4A0B-A03D-2C14CB77E08F}</ProjectGuid>
    <RootNamespace>gitdll</RootNamespace>
    <Keyword>Win32Proj</Keyword>
  </PropertyGroup>
  <Import Project="$(SolutionDir)TortoiseGit.toolset.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <CharacterSet>NotSet</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  <Import Project="$(SolutionDir)TortoiseGit.common.props" />
  <Import Project="$(SolutionDir)TortoiseGit.common-dll.props" />
  <!-- Package-neutral vcpkg wiring only (zlib), not TortoiseGit.vcpkg.props:
       gitdll is the second, independent git backend (see CLAUDE.md) and must
       not share a link line with git2.lib. -->
  <Import Project="$(SolutionDir)TortoiseGit.vcpkg-base.props" />
  <PropertyGroup Label="UserMacros">
    <!-- git's headers come from the tgit-libgit vcpkg port, which mirrors the
         source tree. Must be a property, not ClCompile metadata: inside an
         ItemDefinitionGroup a child element is metadata and $(...) would expand
         to nothing. -->
    <TGitLibgitInclude>$(VcpkgInstalledDir)include\tgit-libgit</TGitLibgitInclude>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <!-- The subdirectories match what git's own build puts on the include
           path. ..\tgit is deliberately absent, so a stale submodule checkout
           cannot shadow the headers the library was actually built from. -->
      <AdditionalIncludeDirectories>$(TGitLibgitInclude);$(TGitLibgitInclude)\compat;$(TGitLibgitInclude)\compat\poll;$(TGitLibgitInclude)\compat\vcbuild;$(TGitLibgitInclude)\compat\vcbuild\include;$(TGitLibgitInclude)\compat\fnmatch;$(TGitLibgitInclude)\compat\regex;$(TGitLibgitInclude)\compat\win32;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- The port generates this from the compile command git's CMake actually
           used. It replaces ext\build\libgit-defines.h, which asserted the same
           thing by hand and had drifted: it claimed NO_PTHREADS, which the real
           build does not set, and omitted HAVE_FSMONITOR_DAEMON_BACKEND, which
           it does. Both change struct layouts, so the disagreement would have
           been silent corruption rather than a link error. -->
      <ForcedIncludeFiles>tgit-libgit-defines.h</ForcedIncludeFiles>
      <PreprocessorDefinitions>GITDLL_EXPORTS;MICROSOFT_WINDOWS_WINBASE_H_DEFINE_INTERLOCKED_CPLUSPLUS_OVERLOADS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <ExceptionHandling>SyncCThrow</ExceptionHandling>
      <LanguageStandard_C>stdc11</LanguageStandard_C>
      <!-- 4005: compat\msvc.h defines the same path macros the port's generated
           defines header carries, with identical values - they come from the
           same build. Suppressed rather than filtered out of the generated
           header, because a denylist of "macros git's own headers happen to
           set" would drift exactly the way libgit-defines.h did. -->
      <DisableSpecificWarnings>4200;4005</DisableSpecificWarnings>
    </ClCompile>
    <Link>
      <AdditionalDependencies>ntdll.lib;wininet.lib;ws2_32.lib;zs$(VcpkgLibSuffix).lib;libgit.lib;advapi32.lib;shell32.lib;user32.lib;ole32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="die.cpp" />
    <ClCompile Include="dllmain.c" />
    <ClCompile Include="gitdll.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="gitdll.h" />
    <ClInclude Include="resource.h" />
    <ClInclude Include="stdafx.h" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="gitdll.rc" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>