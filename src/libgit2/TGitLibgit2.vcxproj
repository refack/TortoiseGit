<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    TortoiseGit's own additions to libgit2: a "filter" filter driver and an SSH
    subtransport that tunnels through an external ssh.exe. Both are registered
    through libgit2's public extension points (git_filter_register /
    git_transport_register, see CGit::CheckAndInitDll in src\Git\Git.cpp), but
    they are *implemented* against libgit2 internals: git__calloc, git_str_*,
    git_net_url_*, git_repository_config__weakptr, git_filter_buffered_stream_new
    and friends.

    Those symbols are not exported from a libgit2 DLL. They are reachable only
    when linking the static library, which is why the vcpkg migration uses the
    x64-windows-static-md triplet and why these three files need a home of their
    own now that they can no longer be compiled inside ext\build\libgit2.vcxproj.
  -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{2F29BEDB-4B28-4F53-9D1C-3BE0766E738E}</ProjectGuid>
    <RootNamespace>TGitLibgit2</RootNamespace>
  </PropertyGroup>
  <Import Project="$(SolutionDir)TortoiseGit.toolset.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <!-- matches the old ext\build\libgit2.vcxproj: libgit2 is a byte-oriented C
         library and does its own UTF-16 conversion via win32\utf-conv.h -->
    <CharacterSet>NotSet</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  <Import Project="$(SolutionDir)TortoiseGit.common.props" />
  <Import Project="$(SolutionDir)TortoiseGit.common-staticlib.props" />
  <Import Project="$(SolutionDir)TortoiseGit.vcpkg.props" />
  <PropertyGroup Label="UserMacros" />
  <ItemDefinitionGroup>
    <ClCompile>
      <!--
        The private header trees the overlay port installs. They are kept as two
        roots because upstream's own build does: `#include "str.h"` must resolve
        under util\ and `#include "repository.h"` under libgit2\. No feature
        defines are listed here on purpose: the installed git2_features.h is
        generated by the same cmake run that produced git2.lib, so it cannot
        drift from it the way a hand-copied define list can.
      -->
      <AdditionalIncludeDirectories>$(VcpkgInstalledDir)include\libgit2-private\libgit2;$(VcpkgInstalledDir)include\libgit2-private\util;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <CompileAs>CompileAsC</CompileAs>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <WarningLevel>Level2</WarningLevel>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="filter-filter.c" />
    <ClCompile Include="ssh-wintunnel.c" />
    <ClCompile Include="system-call.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="filter-filter.h" />
    <ClInclude Include="ssh-wintunnel.h" />
    <ClInclude Include="system-call.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
