<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="UserMacros">
    <IsRelease Condition="'$(Configuration)'=='Release'">true</IsRelease>
    <IsRelease Condition="'$(Configuration)'=='Debug'">false</IsRelease>
    <IsDebug Condition="'$(Configuration)'=='Release'">false</IsDebug>
    <IsDebug Condition="'$(Configuration)'=='Debug'">true</IsDebug>
    <SolutionDir Condition="'$(SolutionDir)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</SolutionDir>
  </PropertyGroup>
  <PropertyGroup Label="Globals">
    <!-- ProjectName>gitdll</ProjectName -->
    <!-- Keyword>Win32Proj</Keyword -->
    <!-- ProjectGuid>{4F0A55DE-DAFD-4A0B-A03D-2C14CB77E08F}</ProjectGuid -->
    <!-- RootNamespace>gitdll</RootNamespace -->
    <VCProjectVersion>18.0</VCProjectVersion>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <!-- Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" / -->
  <PropertyGroup Label="Configuration">
    <!-- ConfigurationType>DynamicLibrary</ConfigurationType -->
    <CharacterSet>Unicode</CharacterSet>
    <!-- LinkIncremental>$(IsDebug)</LinkIncremental -->
    <IntDir>$([MSBuild]::NormalizeDirectory('.build', 'obj', '$(Configuration)', '$(ProjectName)'))</IntDir>
    <OutDir>$([MSBuild]::NormalizeDirectory('.build', 'bin', '$(Configuration)_$(Platform)'))</OutDir>
    <PlatformToolset>v145</PlatformToolset>
    <VCToolsVersion>14.51.36231</VCToolsVersion>
    <MSVCPreviewEnabled>true</MSVCPreviewEnabled>
    <PreferredToolArchitecture>x64</PreferredToolArchitecture>
    <UseOfMfc>Dynamic</UseOfMfc>
    <UseDebugLibraries>$(IsDebug)</UseDebugLibraries>
    <WholeProgramOptimization>$(IsRelease)</WholeProgramOptimization>
    <UseStructuredOutput>true</UseStructuredOutput>
  </PropertyGroup>
  <PropertyGroup Label="Vcpkg">
    <VcpkgEnabled>true</VcpkgEnabled>
    <VcpkgTriplet>$(Platform.ToLowerInvariant())-windows-static-md</VcpkgTriplet>
    <VcpkgInstalledDir>$(SolutionDir)vcpkg_installed\</VcpkgInstalledDir>
    <VcpkgDeployedDir>$([MSBuild]::NormalizeDirectory('$(VcpkgInstalledDir)', '$(VcpkgTriplet)'))</VcpkgDeployedDir>
    <VcpkgIncludeDir>$(VcpkgDeployedDir)include\</VcpkgIncludeDir>
    <VcpkgLibDir Condition="'$(Configuration)' == 'Debug'">$(VcpkgDeployedDir)debug\lib\</VcpkgLibDir>
    <VcpkgLibDir Condition="'$(Configuration)' != 'Debug'">$(VcpkgDeployedDir)lib\</VcpkgLibDir>
    <!-- vcpkg suffixes debug builds of some ports; libgit2 itself does not. -->
    <VcpkgLibSuffix Condition="'$(Configuration)' == 'Debug'">d</VcpkgLibSuffix>
    <VcpkgSentinel>$(VcpkgIncludeDir)zlib.h</VcpkgSentinel>
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
  </PropertyGroup>
  <!-- Import Project="$(SolutionDir)src\TortoiseGit.common.props" / -->
  <!-- Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" / -->
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="Shared">
  </ImportGroup>
  <ImportGroup Label="PropertySheets">
  </ImportGroup>
  <Target Name="VerifyVcpkgRestore" BeforeTargets="ClCompile">
    <!-- zlib.h is used as the sentinel because every port installed by the
         manifest depends on zlib, unlike git2.lib, which a package-neutral
         consumer of this file has no reason to need. -->
    <Error Condition="!Exists('$(VcpkgSentinel)')"
           Text="vcpkg package not restored for $(VcpkgTriplet). Run:  vcpkg install --triplet $(VcpkgTriplet)   (expected $(VcpkgSentinel))" />
  </Target>
  <PropertyGroup Label="MSBuildBinlog">
    <!-- 1. Define your dynamic path using valid project properties -->
    <CustomBinlogPath>$(IntDir)$(ProjectName)-{}.binlog</CustomBinlogPath>
    
    <!-- 2. Pass this path to the MSBuild engine's binary logger property hook -->
    <MSBuildBinaryLogger>File=$(CustomBinlogPath);ProjectImports=Embed</MSBuildBinaryLogger>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <CompileAs>Default</CompileAs>
      <ExceptionHandling>Sync</ExceptionHandling>
      <AdditionalIncludeDirectories>$(ProjectDir);$(SolutionDir)src;$(VcpkgIncludeDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- AdditionalIncludeDirectories>%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories -->
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <StringPooling>true</StringPooling>
      <WholeProgramOptimization>$(IsRelease)</WholeProgramOptimization>
      <LanguageStandard>stdcpplatest</LanguageStandard>
      <LanguageStandard_C>stdclatest</LanguageStandard_C>
      <TreatAngleIncludeAsExternal>true</TreatAngleIncludeAsExternal>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <WarningLevel>Level3</WarningLevel>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <!-- PreprocessorDefinitions>_WIN32_WINNT=0x0A00;_WINDOWS;WINDOWS;NOMINMAX;VC_EXTRALEAN;WIN32_LEAN_AND_MEAN;%(PreprocessorDefinitions)</PreprocessorDefinitions -->
      <PreprocessorDefinitions>_WIN32_WINNT=0x0A00;_WINDOWS;WINDOWS;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions>UNICODE;_UNICODE;GIT_DEPRECATE_HARD;ENABLE_INTSAFE_SIGNED_FUNCTIONS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions>_WIN64;WIN64;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Platform)'=='x64'">_AMD64_;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Platform)'=='ARM64'">_ARM64_;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- BuildStlModules>true</BuildStlModules -->
      <!-- debug -->
      <DebugInformationFormat Condition="'$(Configuration)'=='Debug'">OldStyle</DebugInformationFormat>
      <BasicRuntimeChecks Condition="'$(Configuration)'=='Debug'">EnableFastChecks</BasicRuntimeChecks>
      <Optimization Condition="'$(Configuration)'=='Debug'">Disabled</Optimization>
      <PreprocessorDefinitions Condition="'$(Configuration)'=='Debug'">_DEBUG;DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug'">MultiThreadedDebugDLL</RuntimeLibrary>
      <!-- release -->
      <DebugInformationFormat Condition="'$(Configuration)'=='Release'">ProgramDatabase</DebugInformationFormat>
      <InlineFunctionExpansion Condition="'$(Configuration)'=='Release'">AnySuitable</InlineFunctionExpansion>
      <FavorSizeOrSpeed Condition="'$(Configuration)'=='Release'">Speed</FavorSizeOrSpeed>
      <Optimization Condition="'$(Configuration)'=='Release'">MaxSpeed</Optimization>
      <PreprocessorDefinitions Condition="'$(Configuration)'=='Release'">NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Lib>
      <LinkTimeCodeGeneration>$(IsRelease)</LinkTimeCodeGeneration>
      <TargetMachine Condition="'$(Platform)'=='x64'">MachineX64</TargetMachine>
      <Verbose>$(IsDebug)</Verbose>
    </Lib>
    <Link>
      <AdditionalDependencies>winhttp.lib;rpcrt4.lib;gdi32.lib;crypt32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(VcpkgLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <DataExecutionPrevention>true</DataExecutionPrevention>
      <EnableCOMDATFolding>$(IsRelease)</EnableCOMDATFolding>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <ImageHasSafeExceptionHandlers>$(IsRelease)</ImageHasSafeExceptionHandlers>
      <LinkTimeCodeGeneration Condition="'$(Configuration)'=='Release'">UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
      <OptimizeReferences>$(IsRelease)</OptimizeReferences>
      <RandomizedBaseAddress>true</RandomizedBaseAddress>
      <SetChecksum>$(IsRelease)</SetChecksum>
      <TargetMachine Condition="'$(Platform)'=='x64'">MachineX64</TargetMachine>
    </Link>
    <Midl>
      <TargetEnvironment Condition="'$(Platform)'=='x64'">X64</TargetEnvironment>
      <WarningLevel>3</WarningLevel>
    </Midl>
    <ProjectReference>
      <LinkLibraryDependencies>true</LinkLibraryDependencies>
    </ProjectReference>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(SolutionDir)src;$(VcpkgIncludeDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <Culture>0x0009</Culture>
      <PreprocessorDefinitions Condition="'$(Platform)'=='x64'">_WIN64;WIN64;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Configuration)'=='Debug'">_DEBUG;DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Configuration)'=='Release'">_NDEBUG;NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
    <Manifest>
      <!-- EnableDpiAwareness>true</EnableDpiAwareness -->
      <AdditionalIncludeDirectories>$(VcpkgIncludeDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalManifestFiles>$(SolutionDir)src\compatibility.manifest.xml;%(AdditionalManifestFiles)</AdditionalManifestFiles>
    </Manifest>
  </ItemDefinitionGroup>
  <ItemGroup>
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>
  <ItemGroup>



  </ItemGroup>
  <!-- Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" / -->
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
