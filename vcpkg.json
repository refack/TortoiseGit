{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "tortoisegit",
  "version-string": "2.19.1",
  "description": "Dependencies TortoiseGit consumes through vcpkg instead of a hand-maintained ext/build/*.vcxproj.",
  "builtin-baseline": "4e82e29f14eac2b3422f18f72c7524d04f19924e",
  "dependencies": [
    {
      "name": "libgit2",
      "default-features": false,
      "features": [
        "pcre2",
        "sha256",
        "winhttp"
      ]
    },
    "pcre2",
    "simpleini",
    "zlib"
  ]
}
